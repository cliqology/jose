# Copy this file to .env before starting JOSE.
JOSE_ENV=development
JOSE_LOG_LEVEL=INFO
JOSE_API_HOST=0.0.0.0
JOSE_API_PORT=8000
JOSE_WEB_PORT=3000
JOSE_DEFAULT_USER_EMAIL=scott@example.com
JOSE_SCHEDULER_TOKEN=replace-with-a-long-random-value
JOSE_CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=jose
POSTGRES_USER=jose
POSTGRES_PASSWORD=jose-local-password
DATABASE_URL=postgresql+psycopg://jose:jose-local-password@db:5432/jose

# Browser-visible API URL for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Server-side API URL from inside Docker.
JOSE_INTERNAL_API_BASE_URL=http://api:8000

# Optional AI providers; not used in Phase 0/1.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional future integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
